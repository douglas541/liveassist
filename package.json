{
  "name": "liveassist-chatbot",
  "version": "1.0.0",
  "description": "LLM-first chatbot assistant with extensible specifications",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
